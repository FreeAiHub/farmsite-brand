{
  "name": "FarmSite",
  "version": "1.0.0",
  "color": {
    "soil": "#0E0F0D",
    "soil-2": "#171915",
    "soil-3": "#20231E",
    "dormant": "#2C2F2A",
    "chaff": "#F4F4EF",
    "chaff-dim": "#9A9C94",
    "sprout": "#3DFF8F",
    "sprout-ink": "#0B7A3E",
    "paper": "#F5F3EE",
    "dormant-light": "#D9D6CF",
    "ember": "#FF5A36",
    "ember-ink": "#C0391B"
  },
  "theme": {
    "dark":  { "bg": "soil",  "surface": "soil-2", "text": "chaff", "textDim": "chaff-dim", "accent": "sprout", "onAccent": "soil", "dotOff": "dormant" },
    "light": { "bg": "paper", "surface": "#FFFFFF", "text": "soil", "textDim": "#5E6058", "accent": "ember", "accentText": "ember-ink", "onAccent": "soil", "dotOff": "dormant-light" }
  },
  "font": {
    "display": "Unbounded",
    "body": "Manrope",
    "mono": "JetBrains Mono",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Manrope:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap"
  },
  "radius": { "sm": 10, "md": 18, "lg": 26, "pill": 999 },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "motion": {
    "easeGrow": "cubic-bezier(.22,1,.36,1)",
    "easeSnap": "cubic-bezier(.34,1.56,.64,1)",
    "durations": { "fast": 160, "base": 320, "slow": 640 },
    "stagger": 60
  },
  "mark": {
    "grid": "3x3",
    "lit": [[0,0],[1,0],[2,0],[0,1],[1,1],[0,2]],
    "meaning": "Поле 3×3: 6 точек «взошли» лесенкой 3-2-1 — сайт растёт сам"
  }
}
